+FaultResult DeterministicControlService::Fail(FaultClass fault,
+                                             std::string detail) {
+  FaultResult result;
+  result.ok = session_.FailStep(fault, std::move(detail));
+  if (!result.ok) {
+    result.error = "unable to fail session";
+    result.error_code = ControlErrorCode::kInvalidState;
+  }
+  result.snapshot = session_.GetSnapshot();
+  if (auto evt = session_.last_fault_event()) {
+    result.last_fault_class = evt->fault_class;
+    result.last_fault_phase = evt->fault_phase;
+  }
+  return result;
+}
+
 RecoverResult DeterministicControlService::Recover() {
   RecoverResult result;
   result.ok = session_.Recover();
