+TEST(DeterministicControlServiceTest, RecoverAfterFaultTransitionsToPaused) {
+  DeterministicControlService control;
+  ASSERT_TRUE(control.CreateSession(CreateSessionRequest{.session_id = "rf"}).ok);
+  ASSERT_TRUE(control.StartRunning().ok);
+
+  auto fault = control.Fail(FaultClass::kInvariantViolation, "forced fault");
+  ASSERT_TRUE(fault.ok);
+  EXPECT_EQ(fault.snapshot.state, EngineState::kFaulted);
+
+  auto state_while_faulted = control.GetState();
+  EXPECT_EQ(state_while_faulted.snapshot.state, EngineState::kFaulted);
+
+  auto recover = control.Recover();
+  ASSERT_TRUE(recover.ok);
+  EXPECT_EQ(recover.snapshot.state, EngineState::kPaused);
+
+  auto state_after_recover = control.GetState();
+  EXPECT_EQ(state_after_recover.snapshot.state, EngineState::kPaused);
+
+  auto second_recover = control.Recover();
+  EXPECT_FALSE(second_recover.ok);
+  ASSERT_TRUE(second_recover.error_code.has_value());
+  EXPECT_EQ(second_recover.error_code.value(), ControlErrorCode::kInvalidState);
+}
