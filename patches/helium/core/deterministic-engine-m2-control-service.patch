+#ifndef CHROME_BROWSER_HELIUM_DETERMINISTIC_DETERMINISTIC_CONTROL_SERVICE_H_
+#define CHROME_BROWSER_HELIUM_DETERMINISTIC_DETERMINISTIC_CONTROL_SERVICE_H_
+
+#include "chrome/browser/helium/deterministic/deterministic_control_types.h"
+#include "chrome/browser/helium/deterministic/deterministic_session_service.h"
+
+namespace helium::deterministic {
+
+class DeterministicControlService {
+ public:
+  DeterministicControlService() = default;
+  ~DeterministicControlService() = default;
+
+  DeterministicControlService(const DeterministicControlService&) = delete;
+  DeterministicControlService& operator=(const DeterministicControlService&) =
+      delete;
+
+  CreateSessionResult CreateSession(const CreateSessionRequest& request);
+  StartResult StartStepping();
+  StartResult StartRunning();
+  PauseResult Pause();
+  StepResult Step(const StepRequest& request);
+  StopResult Stop();
+
+  StateResult GetState() const;
+
+ private:
+  DeterministicSessionService session_;
+};
+
+}  // namespace helium::deterministic
+
+#endif  // CHROME_BROWSER_HELIUM_DETERMINISTIC_DETERMINISTIC_CONTROL_SERVICE_H_
