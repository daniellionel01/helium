+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/helium/deterministic/deterministic_control_service.h"
+
+namespace helium::deterministic {
+
+CreateSessionResult DeterministicControlService::CreateSession(
+    const CreateSessionRequest& request) {
+  CreateSessionResult result;
+
+  if (request.session_id.empty()) {
+    result.error = "session id is required";
+    result.snapshot = session_.GetSnapshot();
+    return result;
+  }
+
+  if (!session_.CreateSession(request.session_id, request.config)) {
+    result.error = "session creation failed";
+    result.snapshot = session_.GetSnapshot();
+    return result;
+  }
+
+  result.ok = true;
+  result.snapshot = session_.GetSnapshot();
+  return result;
+}
+
+StartResult DeterministicControlService::StartStepping() {
+  StartResult result;
+  result.ok = session_.StartStepping();
+  if (!result.ok) {
+    result.error = "unable to start stepping";
+  }
+  result.snapshot = session_.GetSnapshot();
+  return result;
+}
+
+StartResult DeterministicControlService::StartRunning() {
+  StartResult result;
+  result.ok = session_.StartRunning();
+  if (!result.ok) {
+    result.error = "unable to start running";
+  }
+  result.snapshot = session_.GetSnapshot();
+  return result;
+}
+
+PauseResult DeterministicControlService::Pause() {
+  PauseResult result;
+  result.ok = session_.Pause();
+  if (!result.ok) {
+    result.error = "unable to pause";
+  }
+  result.snapshot = session_.GetSnapshot();
+  return result;
+}
+
+StepResult DeterministicControlService::Step(const StepRequest& request) {
+  StepResult result;
+
+  if (request.frames == 0) {
+    result.error = "frames must be >= 1";
+    result.snapshot = session_.GetSnapshot();
+    return result;
+  }
+
+  for (uint64_t i = 0; i < request.frames; ++i) {
+    auto ticket = session_.BeginStep();
+    if (!ticket.has_value()) {
+      result.error = "unable to begin step";
+      result.snapshot = session_.GetSnapshot();
+      return result;
+    }
+
+    if (!session_.MarkStepPhaseDone(StepPhase::kTick, base::Microseconds(0)) ||
+        !session_.MarkStepPhaseDone(StepPhase::kRender, base::Microseconds(0)) ||
+        !session_.MarkStepPhaseDone(StepPhase::kPresent, base::Microseconds(0)) ||
+        !session_.MarkStepPhaseDone(StepPhase::kCapture, base::Microseconds(0)) ||
+        !session_.MarkStepPhaseDone(StepPhase::kEncode, base::Microseconds(0)) ||
+        !session_.CommitStep(ticket->step_id)) {
+      result.error = "step commit failed";
+      result.snapshot = session_.GetSnapshot();
+      return result;
+    }
+
+    result.committed_frames += 1;
+  }
+
+  result.ok = true;
+  result.snapshot = session_.GetSnapshot();
+  return result;
+}
+
+StopResult DeterministicControlService::Stop() {
+  StopResult result;
+  result.ok = session_.Stop();
+  if (!result.ok) {
+    result.error = "unable to stop";
+  }
+  return result;
+}
+
+StateResult DeterministicControlService::GetState() const {
+  StateResult result;
+  result.snapshot = session_.GetSnapshot();
+  result.recent_events = session_.recent_events();
+  return result;
+}
+
+}  // namespace helium::deterministic
