--- /dev/null
+++ b/chrome/browser/helium/deterministic/step_transaction_types_unittest.cc
@@ -0,0 +1,40 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/helium/deterministic/step_transaction_types.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace helium::deterministic {
+
+TEST(StepTransactionTypesTest, BuildStepMetricsRequiresCommittedTransaction) {
+  StepTransaction tx;
+  tx.step_id = 7;
+
+  EXPECT_FALSE(BuildStepMetrics(tx, /*had_fault=*/false).has_value());
+
+  tx.commit_done = true;
+  auto metrics = BuildStepMetrics(tx, /*had_fault=*/true);
+  ASSERT_TRUE(metrics.has_value());
+  EXPECT_EQ(metrics->step_id, 7u);
+  EXPECT_TRUE(metrics->had_fault);
+}
+
+TEST(StepTransactionTypesTest, PhaseHelpersReportCompletion) {
+  StepTransaction tx;
+  EXPECT_FALSE(IsFullyCompleted(tx));
+  EXPECT_FALSE(IsPhaseComplete(tx, StepPhase::kCapture));
+
+  tx.tick_done = true;
+  tx.render_done = true;
+  tx.present_done = true;
+  tx.capture_done = true;
+  tx.encode_done = true;
+  tx.commit_done = true;
+
+  EXPECT_TRUE(IsFullyCompleted(tx));
+  EXPECT_TRUE(IsPhaseComplete(tx, StepPhase::kCapture));
+}
+
+}  // namespace helium::deterministic
