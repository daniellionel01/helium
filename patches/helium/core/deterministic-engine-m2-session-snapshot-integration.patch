   return controller_.virtual_time();
 }
 
+DeterministicSessionSnapshot DeterministicSessionService::GetSnapshot() const {
+  DeterministicSessionSnapshot snapshot;
+  snapshot.has_session = has_session_;
+
+  if (!has_session_) {
+    return snapshot;
+  }
+
+  snapshot.session_id = session_id_;
+  snapshot.state = state();
+  snapshot.last_committed_step_id = last_committed_step_id();
+  snapshot.virtual_time = virtual_time();
+  snapshot.has_active_transaction = orchestrator_.has_active_transaction();
+  snapshot.active_step_id = orchestrator_.active_step_id();
+  snapshot.last_step_metrics = orchestrator_.last_metrics();
+  return snapshot;
+}
+
 }  // namespace helium::deterministic
