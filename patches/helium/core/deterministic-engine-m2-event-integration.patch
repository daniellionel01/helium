diff --git a/chrome/browser/helium/deterministic/deterministic_session_service.cc b/chrome/browser/helium/deterministic/deterministic_session_service.cc
index feec91c..87922ff 100644
--- a/chrome/browser/helium/deterministic/deterministic_session_service.cc
+++ b/chrome/browser/helium/deterministic/deterministic_session_service.cc
@@ -21,6 +21,8 @@ bool DeterministicSessionService::CreateSession(std::string session_id,
   has_session_ = true;
   session_id_ = std::move(session_id);
   orchestrator_.Reset();
+  last_step_committed_event_.reset();
+  last_fault_event_.reset();
   return true;
 }
 
@@ -79,6 +81,15 @@ bool DeterministicSessionService::CommitStep(uint64_t step_id) {
   }
 
   orchestrator_.FinalizeCommitSuccess();
+
+  if (session_id_.has_value()) {
+    auto metrics = orchestrator_.last_metrics();
+    if (metrics.has_value()) {
+      last_step_committed_event_ =
+          BuildStepCommittedEvent(session_id_.value(), metrics.value());
+    }
+  }
+
   return true;
 }
 
@@ -89,6 +100,13 @@ bool DeterministicSessionService::FailStep(FaultClass fault,
   }
 
   orchestrator_.FailActiveTransaction(fault, StepPhase::kCommit);
+
+  if (session_id_.has_value()) {
+    last_fault_event_ = BuildFaultEvent(session_id_.value(), fault, detail,
+                                        controller_.virtual_time(),
+                                        orchestrator_.last_metrics());
+  }
+
   return controller_.Fail(fault, std::move(detail));
 }
 
