+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_HELIUM_DETERMINISTIC_DETERMINISTIC_SESSION_EVENT_STREAM_H_
+#define CHROME_BROWSER_HELIUM_DETERMINISTIC_DETERMINISTIC_SESSION_EVENT_STREAM_H_
+
+#include <stdint.h>
+
+#include <deque>
+#include <optional>
+#include <vector>
+
+#include "chrome/browser/helium/deterministic/deterministic_events.h"
+
+namespace helium::deterministic {
+
+enum class SessionEventType {
+  kStepCommitted,
+  kFault,
+};
+
+struct SessionEventEnvelope {
+  uint64_t sequence = 0;
+  SessionEventType type = SessionEventType::kStepCommitted;
+  std::optional<StepCommittedEvent> step_committed;
+  std::optional<FaultEvent> fault;
+};
+
+class SessionEventStream {
+ public:
+  explicit SessionEventStream(size_t max_events = 256);
+  ~SessionEventStream();
+
+  SessionEventStream(const SessionEventStream&) = delete;
+  SessionEventStream& operator=(const SessionEventStream&) = delete;
+
+  void PushStepCommitted(const StepCommittedEvent& event);
+  void PushFault(const FaultEvent& event);
+
+  std::vector<SessionEventEnvelope> events() const;
+  size_t size() const;
+
+  void Clear();
+
+ private:
+  void TrimIfNeeded();
+
+  size_t max_events_;
+  uint64_t next_sequence_ = 1;
+  std::deque<SessionEventEnvelope> events_;
+};
+
+}  // namespace helium::deterministic
+
+#endif  // CHROME_BROWSER_HELIUM_DETERMINISTIC_DETERMINISTIC_SESSION_EVENT_STREAM_H_
