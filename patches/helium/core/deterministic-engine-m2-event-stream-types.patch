+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/helium/deterministic/deterministic_session_event_stream.h"
+
+namespace helium::deterministic {
+
+SessionEventStream::SessionEventStream(size_t max_events)
+    : max_events_(max_events > 0 ? max_events : 1) {}
+
+SessionEventStream::~SessionEventStream() = default;
+
+void SessionEventStream::PushStepCommitted(const StepCommittedEvent& event) {
+  events_.push_back(SessionEventEnvelope{
+      .sequence = next_sequence_++,
+      .type = SessionEventType::kStepCommitted,
+      .step_committed = event,
+      .fault = std::nullopt,
+  });
+  TrimIfNeeded();
+}
+
+void SessionEventStream::PushFault(const FaultEvent& event) {
+  events_.push_back(SessionEventEnvelope{
+      .sequence = next_sequence_++,
+      .type = SessionEventType::kFault,
+      .step_committed = std::nullopt,
+      .fault = event,
+  });
+  TrimIfNeeded();
+}
+
+std::vector<SessionEventEnvelope> SessionEventStream::events() const {
+  return std::vector<SessionEventEnvelope>(events_.begin(), events_.end());
+}
+
+size_t SessionEventStream::size() const {
+  return events_.size();
+}
+
+void SessionEventStream::Clear() {
+  events_.clear();
+}
+
+void SessionEventStream::TrimIfNeeded() {
+  while (events_.size() > max_events_) {
+    events_.pop_front();
+  }
+}
+
+}  // namespace helium::deterministic
