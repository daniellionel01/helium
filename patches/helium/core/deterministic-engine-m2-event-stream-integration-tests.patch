+TEST(DeterministicSessionServiceTest, StreamsEventsInCommitThenFaultOrder) {
+  DeterministicSessionService service;
+  ASSERT_TRUE(service.CreateSession("stream", SessionConfig()));
+  ASSERT_TRUE(service.StartStepping());
+
+  auto ticket1 = service.BeginStep();
+  ASSERT_TRUE(ticket1.has_value());
+  EXPECT_TRUE(service.MarkStepPhaseDone(StepPhase::kTick, base::Milliseconds(1)));
+  EXPECT_TRUE(service.MarkStepPhaseDone(StepPhase::kRender, base::Milliseconds(1)));
+  EXPECT_TRUE(service.MarkStepPhaseDone(StepPhase::kPresent, base::Milliseconds(1)));
+  EXPECT_TRUE(service.MarkStepPhaseDone(StepPhase::kCapture, base::Milliseconds(1)));
+  EXPECT_TRUE(service.MarkStepPhaseDone(StepPhase::kEncode, base::Milliseconds(1)));
+  ASSERT_TRUE(service.CommitStep(ticket1->step_id));
+
+  auto ticket2 = service.BeginStep();
+  ASSERT_TRUE(ticket2.has_value());
+  EXPECT_TRUE(service.MarkStepPhaseDone(StepPhase::kTick, base::Milliseconds(1)));
+  ASSERT_TRUE(service.FailStep(FaultClass::kInvariantViolation, "stream-fault"));
+
+  auto events = service.recent_events();
+  ASSERT_EQ(events.size(), 2u);
+  EXPECT_LT(events[0].sequence, events[1].sequence);
+  EXPECT_EQ(events[0].type, SessionEventType::kStepCommitted);
+  EXPECT_EQ(events[1].type, SessionEventType::kFault);
+}
