+bool DeterministicSessionService::MarkStepPhaseDone(StepPhase phase,
+                                                    base::TimeDelta elapsed) {
+  if (!has_session_ || !active_step_transaction_.has_value()) {
+    return false;
+  }
+
+  StepTransaction& tx = active_step_transaction_.value();
+  if (IsPhaseComplete(tx, phase)) {
+    return false;
+  }
+
+  switch (phase) {
+    case StepPhase::kTick:
+      tx.tick_done = true;
+      tx.timings.tick = elapsed;
+      break;
+    case StepPhase::kRender:
+      tx.render_done = true;
+      tx.timings.render = elapsed;
+      break;
+    case StepPhase::kPresent:
+      tx.present_done = true;
+      tx.timings.present = elapsed;
+      break;
+    case StepPhase::kCapture:
+      tx.capture_done = true;
+      tx.timings.capture = elapsed;
+      break;
+    case StepPhase::kEncode:
+      tx.encode_done = true;
+      tx.timings.encode = elapsed;
+      break;
+    case StepPhase::kCommit:
+      tx.commit_done = true;
+      tx.timings.commit = elapsed;
+      break;
+  }
+
+  return true;
 }
 
 bool DeterministicSessionService::CommitStep(uint64_t step_id) {
-  return has_session_ && controller_.CommitStep(step_id);
+  if (!has_session_ || !active_step_transaction_.has_value()) {
+    return false;
+  }
+
+  StepTransaction& tx = active_step_transaction_.value();
+  if (tx.step_id != step_id) {
+    return false;
+  }
+
+  if (!tx.tick_done || !tx.render_done || !tx.present_done ||
+      !tx.capture_done || !tx.encode_done) {
+    return false;
+  }
+
+  tx.commit_done = true;
+  if (!controller_.CommitStep(step_id)) {
+    tx.commit_done = false;
+    return false;
+  }
+
+  last_step_metrics_ = BuildStepMetrics(tx, /*had_fault=*/false);
+  active_step_transaction_.reset();
+  return true;
 }
 
 bool DeterministicSessionService::FailStep(FaultClass fault,
                                            std::string detail) {
-  return has_session_ && controller_.Fail(fault, std::move(detail));
+  if (!has_session_) {
+    return false;
+  }
+
+  if (active_step_transaction_.has_value()) {
+    active_step_transaction_.value().commit_done = true;
+    last_step_metrics_ =
+        BuildStepMetrics(active_step_transaction_.value(), /*had_fault=*/true);
+    active_step_transaction_.reset();
+  }
+
+  return controller_.Fail(fault, std::move(detail));
 }
 
