+TEST(DeterministicSessionServiceTest, StopClearsEventState) {
+  DeterministicSessionService service;
+  ASSERT_TRUE(service.CreateSession("evt-stop", SessionConfig()));
+  ASSERT_TRUE(service.StartRunning());
+
+  auto ticket = service.BeginStep();
+  ASSERT_TRUE(ticket.has_value());
+  ASSERT_TRUE(service.FailStep(FaultClass::kInvariantViolation, "x"));
+  ASSERT_TRUE(service.last_fault_event().has_value());
+
+  ASSERT_TRUE(service.Stop());
+  EXPECT_FALSE(service.last_fault_event().has_value());
+  EXPECT_FALSE(service.last_step_committed_event().has_value());
+}
