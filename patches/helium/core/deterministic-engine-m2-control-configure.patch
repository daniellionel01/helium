+ConfigureResult DeterministicControlService::Configure(
+    const SessionConfig& config) {
+  ConfigureResult result;
+  result.ok = session_.Configure(config);
+  if (!result.ok) {
+    result.error = "unable to configure session";
+  }
+  result.snapshot = session_.GetSnapshot();
+  return result;
+}
+
+ConfigureResult DeterministicControlService::SetStrictness(Strictness strictness) {
+  SessionConfig config;
+  config.fps = 60;
+  config.strictness = strictness;
+  config.network_budget_per_step_ms = 3;
+  return Configure(config);
+}
+
+ConfigureResult DeterministicControlService::SetNetworkBudgetPerStepMs(
+    int budget_ms) {
+  SessionConfig config;
+  config.fps = 60;
+  config.strictness = Strictness::kBalanced;
+  config.network_budget_per_step_ms = budget_ms;
+  return Configure(config);
+}
