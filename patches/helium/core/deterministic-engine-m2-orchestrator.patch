+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/helium/deterministic/step_transaction_orchestrator.h"
+
+namespace helium::deterministic {
+
+bool StepTransactionOrchestrator::Begin(const StepTicket& ticket) {
+  if (active_.has_value()) {
+    return false;
+  }
+
+  active_ = StepTransaction{
+      .step_id = ticket.step_id,
+      .target_virtual_time = ticket.target_virtual_time,
+  };
+  return true;
+}
+
+bool StepTransactionOrchestrator::MarkPhaseDone(StepPhase phase,
+                                                base::TimeDelta elapsed) {
+  if (!active_.has_value()) {
+    return false;
+  }
+
+  StepTransaction& tx = active_.value();
+  if (IsPhaseComplete(tx, phase)) {
+    return false;
+  }
+
+  switch (phase) {
+    case StepPhase::kTick:
+      tx.tick_done = true;
+      tx.timings.tick = elapsed;
+      return true;
+    case StepPhase::kRender:
+      tx.render_done = true;
+      tx.timings.render = elapsed;
+      return true;
+    case StepPhase::kPresent:
+      tx.present_done = true;
+      tx.timings.present = elapsed;
+      return true;
+    case StepPhase::kCapture:
+      tx.capture_done = true;
+      tx.timings.capture = elapsed;
+      return true;
+    case StepPhase::kEncode:
+      tx.encode_done = true;
+      tx.timings.encode = elapsed;
+      return true;
+    case StepPhase::kCommit:
+      tx.commit_done = true;
+      tx.timings.commit = elapsed;
+      return true;
+  }
+
+  return false;
+}
+
+bool StepTransactionOrchestrator::CanCommit(uint64_t step_id) const {
+  if (!active_.has_value()) {
+    return false;
+  }
+
+  const StepTransaction& tx = active_.value();
+  return tx.step_id == step_id && tx.tick_done && tx.render_done &&
+         tx.present_done && tx.capture_done && tx.encode_done;
+}
+
+void StepTransactionOrchestrator::FinalizeCommitSuccess() {
+  if (!active_.has_value()) {
+    return;
+  }
+
+  StepTransaction tx = active_.value();
+  tx.commit_done = true;
+  if (auto metrics = BuildStepMetrics(tx, /*had_fault=*/false)) {
+    last_metrics_ = metrics;
+  }
+  active_.reset();
+}
+
+bool StepTransactionOrchestrator::FinalizeCommitFailure() {
+  if (!active_.has_value()) {
+    return false;
+  }
+
+  active_.value().commit_done = false;
+  return true;
+}
+
+bool StepTransactionOrchestrator::FailActiveTransaction() {
+  if (!active_.has_value()) {
+    return false;
+  }
+
+  StepTransaction tx = active_.value();
+  tx.commit_done = true;
+  if (auto metrics = BuildStepMetrics(tx, /*had_fault=*/true)) {
+    last_metrics_ = metrics;
+  }
+  active_.reset();
+  return true;
+}
+
+std::optional<uint64_t> StepTransactionOrchestrator::active_step_id() const {
+  if (!active_.has_value()) {
+    return std::nullopt;
+  }
+  return active_.value().step_id;
+}
+
+void StepTransactionOrchestrator::Reset() {
+  active_.reset();
+  last_metrics_.reset();
+}
+
+}  // namespace helium::deterministic
diff --git a/chrome/browser/helium/deterministic/step_transaction_orchestrator.h b/chrome/browser/helium/deterministic/step_transaction_orchestrator.h
