+TEST(DeterministicControlServiceTest, ConfigureRejectsInvalidBudget) {
+  DeterministicControlService control;
+  ASSERT_TRUE(control.CreateSession(CreateSessionRequest{.session_id = "cfg"}).ok);
+
+  SessionConfig config;
+  config.fps = 60;
+  config.strictness = Strictness::kBalanced;
+  config.network_budget_per_step_ms = -1;
+
+  auto result = control.Configure(config);
+  EXPECT_FALSE(result.ok);
+}
+
+TEST(DeterministicControlServiceTest, ConfigureFailsWhileRunning) {
+  DeterministicControlService control;
+  ASSERT_TRUE(control.CreateSession(CreateSessionRequest{.session_id = "run"}).ok);
+  ASSERT_TRUE(control.StartRunning().ok);
+
+  SessionConfig config;
+  config.fps = 60;
+  config.strictness = Strictness::kBalanced;
+  config.network_budget_per_step_ms = 3;
+
+  auto result = control.Configure(config);
+  EXPECT_FALSE(result.ok);
+}
+
+TEST(DeterministicControlServiceTest, ZeroFrameStepIsRejected) {
+  DeterministicControlService control;
+  ASSERT_TRUE(control.CreateSession(CreateSessionRequest{.session_id = "z"}).ok);
+  ASSERT_TRUE(control.StartStepping().ok);
+
+  auto step = control.Step(StepRequest{.frames = 0});
+  EXPECT_FALSE(step.ok);
+}
